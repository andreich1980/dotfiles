#!/usr/bin/env bash

# Strict mode
set -euo pipefail

# Constants
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOME_DIR="${HOME_DIR_MOCK:-${HOME}}" # Allow mocking for tests

# State
DRY_RUN=false

# Help message
usage() {
    cat <<EOF
Usage: $(basename "$0") [options]

Options:
    --dry-run   Show what would be done without making any changes.
    --help      Show this help message.
EOF
    exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --help)
            usage
            ;;
        *)
            echo "Unknown option: $1"
            usage
            ;;
    esac
done

if [[ "$DRY_RUN" == true ]]; then
    echo "--- DRY-RUN MODE ACTIVE ---"
fi

# Dry-run wrapper
run() {
    if [[ "$DRY_RUN" == true ]]; then
        echo "[DRY-RUN] $*"
    else
        "$@"
    fi
}

# Export for modules
export DOTFILES_DIR
export HOME_DIR
export DRY_RUN
export -f run

# Source core library
if [[ -f "$DOTFILES_DIR/lib/core.sh" ]]; then
    # shellcheck source=lib/core.sh
    source "$DOTFILES_DIR/lib/core.sh"
fi

# Load modules
if [[ -d "$DOTFILES_DIR/modules" ]]; then
    for module in "$DOTFILES_DIR/modules"/*.sh; do
        if [[ -f "$module" ]]; then
            echo "-> Applying module: $(basename "$module" .sh)"
            # shellcheck source=/dev/null
            source "$module"
        fi
    done
fi

echo "Done!"
