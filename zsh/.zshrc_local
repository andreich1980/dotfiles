# custom settings: theme, plugins, aliases
ZSH_THEME="avit"

# update automatically without asking
zstyle ':omz:update' mode auto

COMPLETION_WAITING_DOTS="true"

plugins=(
    git
    laravel
    npm
    cp
    zsh-autosuggestions
)

alias a="php artisan"

alias wip='!git add --all && git commit -m "WIP"'
nah() {
    git reset --hard

    if [[ $1 == "-f" ]]; then
        git clean -df
    fi
}

alias dc="docker compose"
alias dce="docker compose exec -it"
alias dcr="docker compose run --rm"
alias dcup="docker compose up -d"
alias dcd="docker compose down"
alias dcrestart="docker compose restart"


alias dcmfs1="docker compose exec -t env1 bash -c 'php artisan migrate:fresh --seed && php artisan module:migrate --seed --all'"
alias dca1="docker compose exec -t env1 php artisan"
alias dcmft1="docker compose exec -t env1 bash -c 'php artisan migrate:fresh --env=testing && php artisan module:migrate --env=testing --all'"

alias dcmfs2="docker compose exec -t env2 bash -c 'php artisan migrate:fresh --seed && php artisan module:migrate --seed --all'"
alias dca2="docker compose exec -t env2 php artisan"
alias dcmft2="docker compose exec -t env2 bash -c 'php artisan migrate:fresh --env=testing && php artisan module:migrate --env=testing --all'"
